# Supabase 연결 정보 (Supabase 프로젝트 → Settings → API)
# 이 값들은 브라우저에 노출되는 공개 키입니다. 데이터 보호는 반드시 RLS 정책으로 합니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Gemini API 키(서버측). /api/parse-order, /api/reconcile 에서 사용.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 공공데이터포털 API 키(서버측). 식약처 의료기기 UDI/EDI 통합조회용.
# https://www.data.go.kr (회원가입 후 활용 신청 → 일반 인증키 발급)
# 발급받은 키를 그대로(인코딩 전 또는 후) 입력. 코드는 양쪽 다 처리하도록 작성할 것.
EDI_API_KEY=

# 로그인 게이트 on/off (true 일 때만 미들웨어가 비로그인 차단).
# 현재 운영은 무로그인(anon). 로그인 도입 시 true 로 전환.
# NEXT_PUBLIC_AUTH_ENABLED=true
